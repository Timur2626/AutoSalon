<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ConfigurationController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Конфигуратор автомобиля" textAlignment="CENTER">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>

                <!-- Информация об автомобиле -->
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="25.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Модель:" />
                        <Label fx:id="carModelLabel" text="Не выбрана" GridPane.columnIndex="1" />

                        <Label text="Базовая цена:" GridPane.rowIndex="1" />
                        <Label fx:id="basePriceLabel" text="0.00 руб." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>

                <!-- Конфигурация -->
                <VBox spacing="10.0">
                    <children>
                        <Label text="Цвет:" />
                        <ComboBox fx:id="colorComboBox" />

                        <Label text="Интерьер:" />
                        <ComboBox fx:id="interiorComboBox" />

                        <Label text="Дополнительные опции:" />
                        <CheckBox fx:id="leatherSeatsCheckBox" text="Кожаные сиденья (+50,000 руб.)" />
                        <CheckBox fx:id="sunroofCheckBox" text="Люк (+80,000 руб.)" />
                        <CheckBox fx:id="navigationCheckBox" text="Навигационная система (+40,000 руб.)" />
                        <CheckBox fx:id="premiumAudioCheckBox" text="Премиум-аудио (+30,000 руб.)" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Итоговая цена:" style="-fx-font-weight: bold;" />
                        <Label fx:id="totalPriceLabel" text="0.00 руб." style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleConfirmConfiguration" text="Подтвердить конфигурацию" />
                        <Button mnemonicParsing="false" onAction="#handleCancel" text="Отмена" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>