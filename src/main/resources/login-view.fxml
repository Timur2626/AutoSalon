<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Автосалон" textAlignment="CENTER">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>
                <VBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 20;">
                    <children>
                        <Label text="Логин:" />
                        <TextField fx:id="usernameField" />
                        <Label text="Пароль:" />
                        <PasswordField fx:id="passwordField" />
                        <Label fx:id="errorLabel" textFill="RED" />
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleLogin" text="Вход" />
                        <Button mnemonicParsing="false" onAction="#handleCancel" text="Отмена" />
                    </children>
                </HBox>
                <Hyperlink onAction="#handleRegister" text="Зарегистрироваться" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>