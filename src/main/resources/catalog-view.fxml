<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CatalogController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Каталог автомобилей" textAlignment="CENTER">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>

                <!-- Фильтры -->
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Марка:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="brandFilter" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Модель:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="modelFilter" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <Label text="Год:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="yearFilter" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Макс. цена:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="maxPriceFilter" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </GridPane>

                <!-- Кнопки фильтров -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleFilter" text="Применить фильтры" />
                        <Button mnemonicParsing="false" onAction="#handleClearFilters" text="Сбросить фильтры" />
                    </children>
                </HBox>

                <!-- Таблица автомобилей -->
                <TableView fx:id="carsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="brandColumn" prefWidth="100.0" text="Марка" />
                        <TableColumn fx:id="modelColumn" prefWidth="100.0" text="Модель" />
                        <TableColumn fx:id="yearColumn" prefWidth="80.0" text="Год" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Цена" />
                        <TableColumn fx:id="colorColumn" prefWidth="80.0" text="Цвет" />
                        <TableColumn fx:id="fuelColumn" prefWidth="80.0" text="Топливо" />
                    </columns>
                </TableView>

                <!-- Выбранный автомобиль и кнопка заказа -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Label fx:id="selectedCarLabel" text="Выберите автомобиль" />
                        <Button mnemonicParsing="false" onAction="#handleOrder" text="Заказать" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>