<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientMainController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Автосалон - Главная" textAlignment="CENTER">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>
                <Label fx:id="welcomeLabel" text="Добро пожаловать!" />
                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleOpenCatalog" text="Каталог автомобилей" />
                        <Button mnemonicParsing="false" onAction="#handleOpenOrders" text="Мои заказы" />
                        <Button mnemonicParsing="false" onAction="#handleExit" text="Выход" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>