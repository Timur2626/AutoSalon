<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="OrderDialogController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Оформление заказа" textAlignment="CENTER">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Text>

                <Label text="Автомобиль:" />
                <Label fx:id="carInfoLabel" text="Не выбран" style="-fx-font-weight: bold;" />

                <Label text="ФИО клиента *:" />
                <TextField fx:id="clientNameField" />

                <Label text="Телефон *:" />
                <TextField fx:id="phoneField" />

                <Label text="Комментарии:" />
                <TextArea fx:id="commentsArea" prefRowCount="3" />

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleConfirm" text="Подтвердить заказ" />
                        <Button mnemonicParsing="false" onAction="#handleCancel" text="Отмена" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>